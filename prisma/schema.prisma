generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model audit_logs {
  id          BigInt       @id @default(autoincrement())
  business_id BigInt
  user_id     BigInt?
  action      audit_action
  entity_type String       @db.VarChar(50)
  entity_id   BigInt
  old_data    Json?
  new_data    Json?
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  businesses  businesses   @relation(fields: [business_id], references: [id], onUpdate: NoAction, map: "fk_audit_business")
  users       users?       @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_audit_user")

  @@index([created_at], map: "idx_audit_created_at")
  @@index([entity_type, entity_id], map: "idx_audit_entity")
}

model bill_deliveries {
  id                BigInt           @id @default(autoincrement())
  bill_id           BigInt           @unique(map: "uq_bill_delivery")
  delivery_agent_id BigInt?
  /// Free-text agent name for a one-off/temporary agent (e.g. "Raju -
  /// Auto") that isn't worth adding to the permanent delivery_agents
  /// list. Mutually exclusive with delivery_agent_id — set at most
  /// one of the two; both null means no agent assigned.
  temp_agent_name   String?          @db.VarChar(100)
  status            delivery_status  @default(GENERATED)
  sent_at           DateTime?        @db.Timestamptz(6)
  reached_at        DateTime?        @db.Timestamptz(6)
  cleared_at        DateTime?        @db.Timestamptz(6)
  notes             String?
  created_at        DateTime         @default(now()) @db.Timestamptz(6)
  updated_at        DateTime         @default(now()) @db.Timestamptz(6)
  delivery_agents   delivery_agents? @relation(fields: [delivery_agent_id], references: [id], onUpdate: NoAction, map: "fk_bill_deliveries_agent")
  bills             bills            @relation(fields: [bill_id], references: [id], onUpdate: NoAction, map: "fk_bill_deliveries_bill")

  @@index([delivery_agent_id], map: "idx_delivery_agent")
  @@index([status], map: "idx_delivery_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bill_items {
  id                 BigInt              @id @default(autoincrement())
  bill_id            BigInt
  item_id            BigInt
  item_unit_id       BigInt?
  item_name_snapshot String              @db.VarChar(150)
  unit               String              @db.VarChar(30)
  quantity           Decimal             @db.Decimal(14, 3)
  standard_rate      Decimal             @db.Decimal(14, 2)
  actual_rate        Decimal             @db.Decimal(14, 2)
  discount           Decimal             @default(0) @db.Decimal(14, 2)
  line_total         Decimal             @db.Decimal(14, 2)
  /// Set only for variable-weight lines (see item_units.is_weight_variable)
  /// — quantity/unit above already carry this same total in kg so
  /// billing/print/PDF work unchanged; this column plus
  /// bill_item_weights are purely the audit trail of how that total
  /// was reached (which container weighed what).
  total_weight_kg    Decimal?            @db.Decimal(14, 3)
  created_at         DateTime            @default(now()) @db.Timestamptz(6)
  bills              bills               @relation(fields: [bill_id], references: [id], onUpdate: NoAction, map: "fk_bill_items_bill")
  items              items               @relation(fields: [item_id], references: [id], onUpdate: NoAction, map: "fk_bill_items_item")
  item_units         item_units?         @relation(fields: [item_unit_id], references: [id], onUpdate: NoAction, map: "fk_bill_items_unit")
  bill_item_weights  bill_item_weights[]

  @@index([bill_id], map: "idx_bill_items_bill")
  @@index([item_id], map: "idx_bill_items_item")
}

/// One row per weighed container (bag/sack/bundle/...) on a
/// variable-weight bill line — e.g. 5 rows for "5 Bags" of Ragi, each
/// holding that bag's actual weight in kg. Purely an audit trail: the
/// owning bill_item's quantity/unit/line_total already reflect the
/// summed total, so nothing else needs to read this table to bill or
/// print correctly.
model bill_item_weights {
  id           BigInt     @id @default(autoincrement())
  bill_item_id BigInt
  sequence     Int
  weight_kg    Decimal    @db.Decimal(10, 3)
  bill_items   bill_items @relation(fields: [bill_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_bill_item_weights_bill_item")

  @@unique([bill_item_id, sequence], map: "uq_bill_item_weights_item_seq")
  @@index([bill_item_id], map: "idx_bill_item_weights_bill_item")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bills {
  id                        BigInt                @id @default(autoincrement())
  business_id               BigInt
  bill_number               String                @db.VarChar(40)
  customer_id               BigInt?
  bill_type                 bill_type             @default(CUSTOMER)
  status                    bill_status           @default(COMPLETED)
  transaction_at            DateTime              @default(now()) @db.Timestamptz(6)
  customer_name_snapshot    String?               @db.VarChar(150)
  customer_phone_snapshot   String?               @db.VarChar(20)
  place_snapshot            String?               @db.VarChar(150)
  customer_address_snapshot String?
  subtotal                  Decimal               @default(0) @db.Decimal(14, 2)
  discount                  Decimal               @default(0) @db.Decimal(14, 2)
  grand_total               Decimal               @default(0) @db.Decimal(14, 2)
  previous_balance          Decimal               @default(0) @db.Decimal(14, 2)
  amount_paid               Decimal               @default(0) @db.Decimal(14, 2)
  current_bill_balance      Decimal               @default(0) @db.Decimal(14, 2)
  overall_balance           Decimal               @default(0) @db.Decimal(14, 2)
  notes                     String?
  created_by                BigInt
  created_at                DateTime              @default(now()) @db.Timestamptz(6)
  updated_at                DateTime              @default(now()) @db.Timestamptz(6)
  bill_deliveries           bill_deliveries?
  bill_items                bill_items[]
  businesses                businesses            @relation(fields: [business_id], references: [id], onUpdate: NoAction, map: "fk_bills_business")
  users                     users                 @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_bills_created_by")
  customers                 customers?            @relation(fields: [customer_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_bills_customer")
  ledger_entries            ledger_entries[]
  payment_allocations       payment_allocations[]
  stock_movements           stock_movements[]

  @@unique([business_id, bill_number], map: "uq_bills_business_bill_number")
  @@index([customer_id], map: "idx_bills_customer")
  @@index([business_id, transaction_at], map: "idx_bills_transaction_at")
}

enum name_display_mode {
  ENGLISH
  TELUGU
  BOTH
}

/// The printed bill/PDF can only show one language at a time (unlike
/// the on-screen name_display_mode, which allows BOTH) — kept as its
/// own enum/setting so an admin can print in Telugu for customers
/// while staff still see English or Both on screen, independently.
enum print_language {
  ENGLISH
  TELUGU
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model businesses {
  id                BigInt            @id @default(autoincrement())
  name              String            @db.VarChar(150)
  proprietor_name   String?           @db.VarChar(150)
  phone             String?           @db.VarChar(20)
  alternate_phone   String?           @db.VarChar(20)
  address           String?
  gst_number        String?           @db.VarChar(30)
  logo_url          String?
  upi_id            String?           @db.VarChar(100)
  upi_phone         String?           @db.VarChar(20)
  name_display_mode name_display_mode @default(ENGLISH)
  print_language    print_language    @default(ENGLISH)
  bill_note         String?           @db.VarChar(300)
  is_active         Boolean           @default(true)
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime          @default(now()) @db.Timestamptz(6)
  audit_logs        audit_logs[]
  bills             bills[]
  categories        categories[]
  customers         customers[]
  delivery_agents   delivery_agents[]
  imports           imports[]
  items             items[]
  ledger_entries    ledger_entries[]
  payables          payables[]
  payments          payments[]
  stock_movements   stock_movements[]
  suppliers         suppliers[]
  users             users[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model categories {
  id          BigInt     @id @default(autoincrement())
  business_id BigInt
  name        String     @db.VarChar(100)
  telugu_name String?    @db.VarChar(100)
  is_active   Boolean    @default(true)
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime   @default(now()) @db.Timestamptz(6)
  businesses  businesses @relation(fields: [business_id], references: [id], onUpdate: NoAction, map: "fk_categories_business")
  items       items[]

  @@unique([business_id, name], map: "uq_categories_business_name")
  @@index([business_id], map: "idx_categories_business")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model customers {
  id              BigInt           @id @default(autoincrement())
  business_id     BigInt
  customer_code   String           @db.VarChar(30)
  english_name    String           @db.VarChar(150)
  telugu_name     String?          @db.VarChar(150)
  phone           String?          @db.VarChar(20)
  alternate_phone String?          @db.VarChar(20)
  place           String?          @db.VarChar(150)
  address         String?
  notes           String?
  is_active       Boolean          @default(true)
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @default(now()) @db.Timestamptz(6)
  bills           bills[]
  businesses      businesses       @relation(fields: [business_id], references: [id], onUpdate: NoAction, map: "fk_customers_business")
  ledger_entries  ledger_entries[]
  payments        payments[]

  @@unique([business_id, customer_code], map: "uq_customers_business_code")
  @@index([business_id], map: "idx_customers_business")
  @@index([business_id, english_name], map: "idx_customers_name")
  @@index([business_id, phone], map: "idx_customers_phone")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model delivery_agents {
  id              BigInt            @id @default(autoincrement())
  business_id     BigInt
  name            String            @db.VarChar(100)
  phone           String?           @db.VarChar(20)
  vehicle_number  String?           @db.VarChar(30)
  notes           String?
  is_active       Boolean           @default(true)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  bill_deliveries bill_deliveries[]
  businesses      businesses        @relation(fields: [business_id], references: [id], onUpdate: NoAction, map: "fk_delivery_agents_business")

  @@index([business_id], map: "idx_delivery_agents_business")
}

/// Lightweight purchase record — supplier + item + quantity + amount +
/// what was actually paid at purchase time. No stock-on-hand tracking:
/// this exists purely to capture the transaction and (via the linked
/// payable) what's still owed to the supplier for it.
model imports {
  id              BigInt            @id @default(autoincrement())
  business_id     BigInt
  supplier_id     BigInt
  item_id         BigInt
  quantity        Decimal           @db.Decimal(14, 3)
  unit            String            @db.VarChar(30)
  amount          Decimal           @db.Decimal(14, 2)
  /// What was actually paid at purchase time — a fixed historical fact,
  /// never updated afterward. Any further payment happens through the
  /// linked payable (payables.import_id), not by revisiting this row.
  paid_amount     Decimal           @default(0) @db.Decimal(14, 2)
  import_date     DateTime          @default(now()) @db.Timestamptz(6)
  notes           String?
  created_by      BigInt
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  businesses      businesses        @relation(fields: [business_id], references: [id], onUpdate: NoAction, map: "fk_imports_business")
  suppliers       suppliers         @relation(fields: [supplier_id], references: [id], onUpdate: NoAction, map: "fk_imports_supplier")
  items           items             @relation(fields: [item_id], references: [id], onUpdate: NoAction, map: "fk_imports_item")
  users           users             @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_imports_created_by")
  payables        payables?
  stock_movements stock_movements[]

  @@index([business_id], map: "idx_imports_business")
  @@index([business_id, supplier_id], map: "idx_imports_supplier")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model item_units {
  id                 BigInt       @id @default(autoincrement())
  item_id            BigInt
  unit               String       @db.VarChar(30)
  standard_price     Decimal      @default(0) @db.Decimal(14, 2)
  is_default         Boolean      @default(false)
  is_active          Boolean      @default(true)
  /// When true, this unit is a container (bag/sack/bundle/...) billed
  /// by actual weight, not a flat per-container price: at billing
  /// time, quantity means "how many containers", staff enters each
  /// container's real weight, and standard_price/actual_rate are a
  /// rate per kg applied to the summed weight. Defaults off so
  /// existing units (e.g. a flat-rate "Bag" already priced per bag)
  /// are never silently reinterpreted — an admin opts a unit in.
  is_weight_variable Boolean      @default(false)
  created_at         DateTime     @default(now()) @db.Timestamptz(6)
  updated_at         DateTime     @default(now()) @db.Timestamptz(6)
  bill_items         bill_items[]
  items              items        @relation(fields: [item_id], references: [id], onUpdate: NoAction, map: "fk_item_units_item")

  @@unique([item_id, unit], map: "uq_item_units_item_unit")
  @@index([item_id], map: "idx_item_units_item")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model items {
  id              BigInt            @id @default(autoincrement())
  business_id     BigInt
  category_id     BigInt?
  item_code       String            @db.VarChar(30)
  english_name    String            @db.VarChar(150)
  telugu_name     String?           @db.VarChar(150)
  description     String?
  is_active       Boolean           @default(true)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  bill_items      bill_items[]
  item_units      item_units[]
  imports         imports[]
  stock_movements stock_movements[]
  businesses      businesses        @relation(fields: [business_id], references: [id], onUpdate: NoAction, map: "fk_items_business")
  categories      categories?       @relation(fields: [category_id], references: [id], onUpdate: NoAction, map: "fk_items_category")

  @@unique([business_id, item_code], map: "uq_items_business_code")
  @@unique([business_id, english_name], map: "uq_items_business_name")
  @@index([business_id], map: "idx_items_business")
  @@index([category_id], map: "idx_items_category")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ledger_entries {
  id             BigInt            @id @default(autoincrement())
  business_id    BigInt
  customer_id    BigInt
  entry_type     ledger_entry_type
  bill_id        BigInt?
  payment_id     BigInt?
  transaction_at DateTime          @default(now()) @db.Timestamptz(6)
  debit          Decimal           @default(0) @db.Decimal(14, 2)
  credit         Decimal           @default(0) @db.Decimal(14, 2)
  balance_after  Decimal           @db.Decimal(14, 2)
  description    String?
  created_at     DateTime          @default(now()) @db.Timestamptz(6)
  bills          bills?            @relation(fields: [bill_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_ledger_bill")
  businesses     businesses        @relation(fields: [business_id], references: [id], onUpdate: NoAction, map: "fk_ledger_business")
  customers      customers         @relation(fields: [customer_id], references: [id], onUpdate: NoAction, map: "fk_ledger_customer")
  payments       payments?         @relation(fields: [payment_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_ledger_payment")

  @@index([customer_id, transaction_at], map: "idx_ledger_customer_date")
}

/// "My Pays" — money the business owes to others (suppliers,
/// transporters, etc.), the mirror image of the customer
/// payments/ledger system but deliberately separate from it: no
/// relation to customers, bills, or ledger_entries anywhere in this
/// model or payable_payments below.
model payables {
  id               BigInt             @id @default(autoincrement())
  business_id      BigInt
  supplier_id      BigInt
  /// Set only when this payable was auto-created for an import's
  /// pending balance (see imports.paid_amount) — null for every
  /// ordinary/manually-created payable, including opening balances.
  import_id        BigInt?            @unique
  total_amount     Decimal            @db.Decimal(14, 2)
  /// Running total of payable_payments — denormalized the same way
  /// bills.amount_paid is, for fast list-page reads without summing
  /// child rows every time.
  amount_paid      Decimal            @default(0) @db.Decimal(14, 2)
  reason           String
  /// The date the expense/amount was actually incurred, chosen
  /// manually by the admin on the form (defaults to today there, but
  /// is never forced to be "now" server-side) — distinct from
  /// paid_at/payable_payments.payment_date, which is when money was
  /// actually paid out against this payable.
  payable_date     DateTime           @default(now()) @db.Timestamptz(6)
  status           payable_status     @default(PENDING)
  paid_at          DateTime?          @db.Timestamptz(6)
  created_by       BigInt
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  businesses       businesses         @relation(fields: [business_id], references: [id], onUpdate: NoAction, map: "fk_payables_business")
  suppliers        suppliers          @relation(fields: [supplier_id], references: [id], onUpdate: NoAction, map: "fk_payables_supplier")
  imports          imports?           @relation(fields: [import_id], references: [id], onUpdate: NoAction, map: "fk_payables_import")
  users            users              @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_payables_created_by")
  payable_payments payable_payments[]

  @@index([business_id], map: "idx_payables_business")
  @@index([business_id, status], map: "idx_payables_status")
  @@index([business_id, payable_date], map: "idx_payables_payable_date")
  @@index([business_id, supplier_id], map: "idx_payables_supplier")
}

/// One row per partial/full payment made against a payable — an
/// append-only history, the payable-side mirror of `payments`.
model payable_payments {
  id               BigInt          @id @default(autoincrement())
  payable_id       BigInt
  amount           Decimal         @db.Decimal(14, 2)
  payment_date     DateTime        @default(now()) @db.Timestamptz(6)
  payment_method   payment_method?
  reference_number String?         @db.VarChar(100)
  notes            String?
  created_by       BigInt
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  payables         payables        @relation(fields: [payable_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_payable_payments_payable")
  users            users           @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_payable_payments_created_by")

  @@index([payable_id], map: "idx_payable_payments_payable")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payment_allocations {
  id               BigInt   @id @default(autoincrement())
  payment_id       BigInt
  bill_id          BigInt
  allocated_amount Decimal  @db.Decimal(14, 2)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  bills            bills    @relation(fields: [bill_id], references: [id], onUpdate: NoAction, map: "fk_payment_allocations_bill")
  payments         payments @relation(fields: [payment_id], references: [id], onUpdate: NoAction, map: "fk_payment_allocations_payment")

  @@unique([payment_id, bill_id], map: "uq_payment_bill")
  @@index([bill_id], map: "idx_payment_allocations_bill")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payments {
  id                  BigInt                @id @default(autoincrement())
  business_id         BigInt
  payment_number      String                @db.VarChar(40)
  customer_id         BigInt
  payment_at          DateTime              @default(now()) @db.Timestamptz(6)
  amount              Decimal               @db.Decimal(14, 2)
  payment_method      payment_method
  reference_number    String?               @db.VarChar(100)
  notes               String?
  created_by          BigInt
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  ledger_entries      ledger_entries[]
  payment_allocations payment_allocations[]
  businesses          businesses            @relation(fields: [business_id], references: [id], onUpdate: NoAction, map: "fk_payments_business")
  users               users                 @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_payments_created_by")
  customers           customers             @relation(fields: [customer_id], references: [id], onUpdate: NoAction, map: "fk_payments_customer")

  @@unique([business_id, payment_number], map: "uq_payments_business_number")
  @@index([customer_id], map: "idx_payments_customer")
  @@index([business_id, payment_at], map: "idx_payments_payment_at")
}

/// One row per stock-affecting event for an item — the inventory mirror
/// of `ledger_entries` (same shape: running `balance_after`, a
/// compensating ADJUSTMENT row on bill cancellation rather than
/// mutating history). IMPORT rows carry quantity_in, SALE rows carry
/// quantity_out, ADJUSTMENT rows (cancellation reversals) carry
/// quantity_in again. Quantities are raw numbers in whatever unit the
/// source transaction used — no unit-conversion system exists, so an
/// item must be imported/billed in one consistent unit for its totals
/// to be meaningful.
model stock_movements {
  id             BigInt              @id @default(autoincrement())
  business_id    BigInt
  item_id        BigInt
  movement_type  stock_movement_type
  bill_id        BigInt?
  import_id      BigInt?
  transaction_at DateTime            @default(now()) @db.Timestamptz(6)
  quantity_in    Decimal             @default(0) @db.Decimal(14, 3)
  quantity_out   Decimal             @default(0) @db.Decimal(14, 3)
  balance_after  Decimal             @db.Decimal(14, 3)
  description    String?
  created_by     BigInt
  created_at     DateTime            @default(now()) @db.Timestamptz(6)
  businesses     businesses          @relation(fields: [business_id], references: [id], onUpdate: NoAction, map: "fk_stock_movements_business")
  items          items               @relation(fields: [item_id], references: [id], onUpdate: NoAction, map: "fk_stock_movements_item")
  bills          bills?              @relation(fields: [bill_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_stock_movements_bill")
  imports        imports?            @relation(fields: [import_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_stock_movements_import")
  users          users               @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_stock_movements_created_by")

  @@index([business_id, item_id], map: "idx_stock_movements_business_item")
  @@index([item_id, transaction_at], map: "idx_stock_movements_item_date")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model suppliers {
  id              BigInt     @id @default(autoincrement())
  business_id     BigInt
  name            String     @db.VarChar(150)
  telugu_name     String?    @db.VarChar(150)
  phone           String?    @db.VarChar(20)
  alternate_phone String?    @db.VarChar(20)
  organization    String?    @db.VarChar(150)
  address         String?
  notes           String?
  is_active       Boolean    @default(true)
  created_at      DateTime   @default(now()) @db.Timestamptz(6)
  updated_at      DateTime   @default(now()) @db.Timestamptz(6)
  businesses      businesses @relation(fields: [business_id], references: [id], onUpdate: NoAction, map: "fk_suppliers_business")
  payables        payables[]
  imports         imports[]

  @@index([business_id], map: "idx_suppliers_business")
  @@index([business_id, name], map: "idx_suppliers_name")
  @@index([business_id, phone], map: "idx_suppliers_phone")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id               BigInt             @id @default(autoincrement())
  business_id      BigInt
  name             String             @db.VarChar(100)
  username         String             @db.VarChar(100)
  password_hash    String
  role             user_role          @default(STAFF)
  is_active        Boolean            @default(true)
  last_login_at    DateTime?          @db.Timestamptz(6)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  audit_logs       audit_logs[]
  bills            bills[]
  imports          imports[]
  payments         payments[]
  payables         payables[]
  payable_payments payable_payments[]
  stock_movements  stock_movements[]
  businesses       businesses         @relation(fields: [business_id], references: [id], onUpdate: NoAction, map: "fk_users_business")

  @@unique([business_id, username], map: "uq_users_business_username")
  @@index([business_id], map: "idx_users_business")
}

